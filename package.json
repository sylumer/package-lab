{
  "name": "package-lab",
  "version": "0.2.0",
  "description": "Find out why an e-learning package (SCORM, cmi5, xAPI) doesn't work: check its files, run it under the debugger, and get findings with causes and fixes.",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "electron . --serve --no-window",
    "test": "node test/test.js",
    "package": "node scripts/package.js",
    "install-app": "node scripts/package.js --install",
    "alfred": "node scripts/alfred.js"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^45.3.2",
    "playwright": "^1.65.1"
  },
  "productName": "Package Lab",
  "bin": {
    "package-lab": "bin/package-lab.js"
  }
}
