{
  "name": "package-lab",
  "version": "0.3.0",
  "description": "Find out why an e-learning package (SCORM, cmi5, xAPI) doesn't work: check its files, run it under the debugger, and get findings with causes and fixes.",
  "license": "AGPL-3.0-only",
  "author": "Stephen Millard",
  "homepage": "https://packagelab.thoughtasylum.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sylumer/package-lab.git"
  },
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "electron . --serve --no-window",
    "test": "node test/test.js",
    "test:ui": "node test/ui.js",
    "screenshots": "node scripts/screenshots.js",
    "practice": "node scripts/practice-kit.js",
    "guide": "node scripts/guide-html.js",
    "guide:pdf": "node scripts/guide-pdf.js",
    "package": "node scripts/package.js",
    "install-app": "node scripts/package.js --install",
    "alfred": "node scripts/alfred.js"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^45.3.2",
    "playwright": "^1.65.1",
    "resedit": "3.1.0"
  },
  "productName": "Package Lab",
  "bin": {
    "package-lab": "bin/package-lab.js"
  }
}
